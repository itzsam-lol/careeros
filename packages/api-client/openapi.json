{
  "openapi": "3.1.0",
  "info": {
    "title": "CareerOS API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe (checks the database)",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Get Me",
        "operationId": "get_me_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/me/settings": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Get Settings",
        "operationId": "get_settings_api_v1_me_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSettings"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "me"
        ],
        "summary": "Patch Settings",
        "operationId": "patch_settings_api_v1_me_settings_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Patch",
                "examples": [
                  {
                    "matching": {
                      "high_match_threshold": 0.8
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSettings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchingSettings": {
        "properties": {
          "high_match_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "High Match Threshold",
            "default": 0.75
          },
          "notify_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Notify Threshold",
            "default": 0.55
          }
        },
        "type": "object",
        "title": "MatchingSettings"
      },
      "MeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "auth_provider": {
            "type": "string",
            "title": "Auth Provider"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "settings": {
            "$ref": "#/components/schemas/UserSettings"
          },
          "has_profile": {
            "type": "boolean",
            "title": "Has Profile",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "auth_provider",
          "created_at",
          "settings"
        ],
        "title": "MeResponse"
      },
      "NotificationSettings": {
        "properties": {
          "notify_new_jobs": {
            "type": "boolean",
            "title": "Notify New Jobs",
            "default": true
          },
          "deadline_warning_hours": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 1.0,
            "title": "Deadline Warning Hours",
            "default": 72
          }
        },
        "type": "object",
        "title": "NotificationSettings"
      },
      "OutreachLimits": {
        "properties": {
          "max_emails_per_day": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Max Emails Per Day",
            "default": 5
          },
          "max_emails_per_company_per_day": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Max Emails Per Company Per Day",
            "default": 1
          },
          "max_follow_ups_per_contact": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Max Follow Ups Per Contact",
            "default": 1
          },
          "follow_up_after_days": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Follow Up After Days",
            "default": 5
          },
          "contact_cooldown_days": {
            "type": "integer",
            "maximum": 90.0,
            "minimum": 0.0,
            "title": "Contact Cooldown Days",
            "default": 7
          }
        },
        "type": "object",
        "title": "OutreachLimits",
        "description": "Conservative defaults that protect the user from accidental spam (spec \u00a787)."
      },
      "ResumeSettings": {
        "properties": {
          "template": {
            "type": "string",
            "title": "Template",
            "default": "classic"
          },
          "include_unverified": {
            "type": "boolean",
            "title": "Include Unverified",
            "default": false
          },
          "max_pages": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Max Pages",
            "default": 1
          }
        },
        "type": "object",
        "title": "ResumeSettings"
      },
      "UserSettings": {
        "properties": {
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "UTC"
          },
          "matching": {
            "$ref": "#/components/schemas/MatchingSettings"
          },
          "outreach": {
            "$ref": "#/components/schemas/OutreachLimits"
          },
          "resume": {
            "$ref": "#/components/schemas/ResumeSettings"
          },
          "notifications": {
            "$ref": "#/components/schemas/NotificationSettings"
          }
        },
        "type": "object",
        "title": "UserSettings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Firebase ID token (or dev token locally)",
        "scheme": "bearer"
      }
    }
  }
}
