{
  "expo": {
    "name": "CareerOS",
    "slug": "careeros",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "careeros",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.careeros.app"
    },
    "android": {
      "package": "com.careeros.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#1E7BFF",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 104,
          "backgroundColor": "#F2F2F7"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-sharing",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0A84FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F2F2F7"
  }
}
