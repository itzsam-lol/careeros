# CareerOS configuration. Copy to `.env` and adjust. Never commit real credentials.
# Everything works locally with the defaults below (local AI heuristics, mock email, dev auth).

# --- Application ---------------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Database (docker compose maps Postgres to host port 5433) ------------------------
DATABASE_URL=postgresql+asyncpg://careeros:careeros@localhost:5433/careeros
TEST_DATABASE_URL=postgresql+asyncpg://careeros:careeros@localhost:5433/careeros_test

# --- Authentication ------------------------------------------------------------------
AUTH_MODE=dev                       # dev (local only) | firebase
DEV_AUTH_TOKEN=dev-token
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Secrets (required outside development) -----------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SIGNING_SECRET=

# --- Internal endpoints (Cloud Scheduler / Pub/Sub push) -----------------------------
INTERNAL_AUTH_MODE=token            # token (local) | oidc (deployed)
INTERNAL_API_TOKEN=dev-internal-token
INTERNAL_OIDC_AUDIENCE=
INTERNAL_OIDC_SERVICE_ACCOUNT=

# --- Google Cloud --------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=asia-south1
TASK_DISPATCH_MODE=database         # database (local worker polls) | pubsub
PUBSUB_TOPIC_DISCOVERY=careeros-discovery
PUBSUB_TOPIC_ANALYSIS=careeros-analysis
PUBSUB_TOPIC_APPLICATION=careeros-application
PUBSUB_TOPIC_OUTREACH=careeros-outreach
STORAGE_BACKEND=local               # local | gcs
GCS_BUCKET=

# --- AI routing: local | bedrock | gemini ---------------------------------------------
# `local` uses deterministic heuristics and a hashing embedder: no keys, no cost.
LLM_EXTRACTION_PROVIDER=local
LLM_MATCH_PROVIDER=local
LLM_RESUME_PROVIDER=local
LLM_OUTREACH_PROVIDER=local
LLM_RESEARCH_PROVIDER=local
LLM_APPLICATION_PROVIDER=local
LLM_PROFILE_IMPORT_PROVIDER=local
EMBEDDING_PROVIDER=local

# Claude via Amazon Bedrock (model / inference-profile ids enabled in your account)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_DEFAULT=
BEDROCK_MODEL_EXTRACTION=
BEDROCK_MODEL_MATCH=
BEDROCK_MODEL_RESUME=
BEDROCK_MODEL_OUTREACH=
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Google Gemini: either an API key, or Vertex AI with Application Default Credentials
GEMINI_API_KEY=
GEMINI_USE_VERTEXAI=false
GEMINI_VERTEX_LOCATION=global
GEMINI_MODEL_DEFAULT=gemini-3.5-flash
GEMINI_MODEL_EXTRACTION=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Email ---------------------------------------------------------------------------
EMAIL_PROVIDER=mock                 # mock (writes .eml files locally) | gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# --- Web search for company research / contact discovery (optional) -----------------
SEARCH_PROVIDER=none                # none | brave | google_cse
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# --- Browser automation ----------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true

# --- Human-in-the-loop (must stay false: approval is always required) ------------------
AUTO_SUBMIT_APPLICATIONS=false
AUTO_SEND_EMAILS=false

# --- Resume rendering ------------------------------------------------------------------
LATEX_ENGINE=auto                   # auto | tectonic | xelatex | lualatex | pdflatex

# --- Frontends -------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_DEV_AUTH_TOKEN=dev-token
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
